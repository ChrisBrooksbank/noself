{
    "ignoreBinaries": ["netlify"],
    "paths": {
        "@/*": ["src/*"],
        "@api/*": ["src/api/*"],
        "@core/*": ["src/core/*"],
        "@utils/*": ["src/utils/*"],
        "@config/*": ["src/config/*"],
        "@types/*": ["src/types/*"]
    },
    "entry": [
        "src/api/index.ts",
        "src/sw.ts",
        "src/core/index.ts",
        "src/types/index.ts",
        "src/utils/index.ts",
        "src/config/index.ts",
        "src/content/concepts/index.ts",
        "src/content/meditations/index.ts",
        "src/content/prompts/index.ts",
        "src/content/paths/index.ts",
        "src/content/sutras/index.ts",
        "src/content/pujas/index.ts",
        "src/content/mantras/index.ts",
        "src/content/primers/index.ts",
        "src/content/videos/index.ts",
        "netlify/functions/delete-push-subscription.ts",
        "netlify/functions/save-push-subscription.ts",
        "netlify/functions/send-daily-reminders.ts"
    ]
}
